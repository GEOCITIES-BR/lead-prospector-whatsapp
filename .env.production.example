# =============================================================================
# Lead Prospector WhatsApp — Configuração de Produção
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://user:password@host:5432/lead_prospector?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

WAHA_API_URL=http://waha:3002
WAHA_API_KEY=your-waha-api-key

N8N_WEBHOOK_URL=http://n8n:5678/webhook
N8N_API_KEY=your-n8n-api-key

SCRAPER_RATE_LIMIT_MS=1000
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000

SCORE_WEIGHT_LINKEDIN=20
SCORE_WEIGHT_COMPANY=15
SCORE_WEIGHT_EMAIL=10
SCORE_WEIGHT_WEBSITE=5
SCORE_WEIGHT_PHONE=5

CORS_ORIGIN=https://app.leadprospector.com

LOG_LEVEL=info
LOG_PRETTY=false
