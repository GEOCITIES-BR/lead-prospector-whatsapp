# Production environment
# Copy to .env.production and fill secrets.
# NEVER commit the real .env.production.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Supabase PostgreSQL (managed)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lead_prospector

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-prod

WAHA_API_URL=http://waha:3002
WAHA_API_KEY=change-me-prod

N8N_WEBHOOK_URL=https://n8n.leadprospector.app/webhook
N8N_API_KEY=change-me-prod

SCRAPER_RATE_LIMIT_MS=3000
SCRAPER_MAX_RETRIES=2
SCRAPER_TIMEOUT_MS=60000

CORS_ORIGIN=https://app.leadprospector.app

LOG_LEVEL=warn
LOG_PRETTY=false
