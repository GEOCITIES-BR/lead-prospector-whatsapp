# =============================================================================
# Lead Prospector WhatsApp — Configuração via Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o .env real no repositório.
# =============================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Banco de Dados (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_prospector
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- WAHA WhatsApp API ---
WAHA_API_URL=http://localhost:3002
WAHA_API_KEY=your-waha-api-key

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# --- Scraping ---
SCRAPER_RATE_LIMIT_MS=1000
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT_MS=30000

# --- Lead Scoring ---
SCORE_WEIGHT_LINKEDIN=20
SCORE_WEIGHT_COMPANY=15
SCORE_WEIGHT_EMAIL=10
SCORE_WEIGHT_WEBSITE=5
SCORE_WEIGHT_PHONE=5

# --- Auth ---
JWT_SECRET=your-jwt-secret-change-in-production
AUTH_EMAIL=admin@leadprospector.app
AUTH_PASSWORD=change-me
# Admin user for seed (used when DB users exist)
ADMIN_EMAIL=admin@leadprospector.app
ADMIN_PASSWORD=admin

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true
