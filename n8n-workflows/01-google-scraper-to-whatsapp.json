{
  "name": "Google Scraper → Enriquecer → WhatsApp",
  "nodes": [
    {
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {}
    },
    {
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Scrape Google",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/n8n/scrape-google",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "query", "value": "={{ $json.query }}", "parameterType": "string" },
            { "name": "location", "value": "={{ $json.location }}", "parameterType": "string" },
            { "name": "maxResults", "value": "={{ $json.maxResults }}", "parameterType": "number" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Enriquecer Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/enrich/lead/{{ $json.data[0].id }}",
        "authentication": "none",
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "d4e5f6a7-b8c9-0123-defa-123456789012",
      "name": "IF Score > 50",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1020, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "if-condition-1",
              "leftValue": "={{ $json.score }}",
              "rightValue": "50",
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              }
            }
          ]
        }
      }
    },
    {
      "id": "e5f6a7b8-c9d0-1234-efab-123456789012",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 200],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/n8n/send-message",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "leadId", "value": "={{ $json.leadId }}", "parameterType": "string" },
            { "name": "conteudo", "value": "Olá! Encontramos seu perfil e gostaríamos de conversar.", "parameterType": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f6a7b8c9-d0e1-2345-fabc-123456789012",
      "name": "Lead ignorado (score baixo)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1280, 400],
      "parameters": {}
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[ { "node": "Scrape Google", "type": "main", "index": 0 } ]] },
    "Scrape Google": { "main": [[ { "node": "Enriquecer Leads", "type": "main", "index": 0 } ]] },
    "Enriquecer Leads": { "main": [[ { "node": "IF Score > 50", "type": "main", "index": 0 } ]] },
    "IF Score > 50": {
      "main": [
        [ { "node": "Send WhatsApp", "type": "main", "index": 0 } ],
        [ { "node": "Lead ignorado (score baixo)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": { "timezone": "America/Sao_Paulo" },
  "staticData": null,
  "tags": []
}
